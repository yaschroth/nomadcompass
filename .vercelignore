# Build-only files — not needed in the deployed site (keeps deploy lean + private).
# NOTE: runtime JS (scripts/supabase-config.js, votes.js, auth.js) is .js and stays deployed.
*.md
scripts/*.cjs
scripts/*.py

# Reference templates the generators copy their nav and footer from. Nothing on the site links to
# them and they are not in the sitemap, but they were being served: components/footer.html carried
# twelve relative links to pages that do not exist, all of them 404s for anyone who found it.
components/

# Saved copies of third-party pages, kept as fixtures for the source parsers. They are other
# people's markup and have no business on this domain.
tests/
