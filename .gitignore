node_modules/

# Vercel
.vercel/

.vercel

# Do NOT commit anything under public/.
# This is a plain static site served from the repo root. If a non-empty
# public/ directory is committed, Vercel switches its web root to public/
# and the entire site 404s. Author photo lives in assets/ instead.
/public/

# Local-only image-conversion tooling (sharp); site is static, Vercel must not npm-build
package.json
package-lock.json

# Stray hero-image candidate downloads. Image agents save candidates to
# C:/tmp/city-image-candidates/, but guard against a relative-path leak into the repo root.
/*_c[0-9]*.jpg
/*_c[0-9]*.jpeg
/*_c[0-9]*.png
/*_c[0-9]*.webp

# Private outreach catalogue. Everything in this repo is deployed to Vercel as a static
# file, so data/outreach-*.json would be fetchable at thenomadhq.com/data/... . The list is
# for the private Backlink-Pipeline artifact only. Rebuild it locally with:
#   node scripts/build_outreach_dataset.cjs && node scripts/build_outreach_payload.cjs
data/outreach-targets.json
data/outreach-payload.json
# Which outreach targets were checked and when. Derived from the private catalogue above,
# so it stays out of the deployed tree for the same reason.
data/backlink-checks.json
