{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.thenomadhq.com"
        }
      ],
      "destination": "https://thenomadhq.com/:path*",
      "permanent": true
    },
    {
      "source": "/cities/granadanicaragua",
      "destination": "/cities/granada",
      "permanent": true
    },
    {
      "source": "/cities/luzern",
      "destination": "/cities/lucerne",
      "permanent": true
    },
    {
      "source": "/cities/cuencaec",
      "destination": "/cities/cuenca",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
